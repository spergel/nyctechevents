{
  "name": "nycevents",
  "version": "0.1.0",
  "private": true,
  "description": "A futuristic cyberpunk-themed website that aggregates and displays NYC tech events, communities, and locations",
  "author": "NYC Events Team",
  "license": "ISC",
  "homepage": "https://tech.somethingtodo.nyc",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/nycevents.git"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbo",
    "prebuild": "mkdir -p public/data && if [ -f public/data/events.json ]; then echo 'Using existing public/data/events.json'; elif [ -f scraper/data/combined_events.json ]; then cp scraper/data/combined_events.json public/data/events.json; elif [ -f data/scrapers/google_calendar_events.json ]; then cp data/scrapers/google_calendar_events.json public/data/events.json; else echo '{\"events\": [], \"last_updated\": \"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"}' > public/data/events.json; fi",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "scrape": "python -m scraper.run_all",
    "clean": "rm -rf .next out",
    "analyze": "ANALYZE=true npm run build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@types/glob": "^8.1.0",
    "@types/mapbox-gl": "^3.4.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "glob": "^11.0.1",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.10.0",
    "next": "^16.0.7",
    "node-fetch": "^2.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.120.1"
  },
  "overrides": {
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1"
  }
}
